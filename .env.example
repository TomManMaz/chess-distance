# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# CockroachDB / PostgreSQL connection string (used by Next.js server code and Python ETL)
# Format: postgresql://user:pass@host:26257/defaultdb?sslmode=verify-full
# IMPORTANT: do NOT include channel_binding=require (breaks on Vercel)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional — override which backend the Next.js frontend talks to.
# Unset or empty = Railway FastAPI sidecar (default; matches production).
# Set to another URL to point the frontend at a different backend.
# Set to the literal "same-origin" to fall back to the Next.js /api/* route handlers
# (useful if Railway is down and you want Vercel to serve everything itself — this
# path needs DATABASE_URL configured on the frontend deployment).
# NEXT_PUBLIC_API_BASE=https://my-custom-backend.example.com
# NEXT_PUBLIC_API_BASE=same-origin

# Optional — extra origin allowed by the FastAPI CORS middleware (api/main.py).
# localhost:3000 and the production Vercel URL are already hard-allowed.
# CORS_ORIGIN=https://preview-branch.vercel.app
