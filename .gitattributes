# Normalize line endings to LF in the repo; check out as-is on all platforms.
# This prevents the CRLF/LF noise when collaborating across Windows and Linux.

* text=auto eol=lf

# Force LF for shell scripts (would break on Windows if CRLF)
*.sh text eol=lf

# Force LF for JS/TS source files
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.css text eol=lf
*.mjs text eol=lf

# Binary files — never touch line endings
*.zip binary
*.pgn binary
*.png binary
*.jpg binary
*.ico binary
